SECRET_KEY=change-me
DATABASE_URL=sqlite:///data/practice.db
DOMAIN=localhost
BASE_URL=http://localhost:5055
# Email (leave blank to log emails to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=billing@example.com
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Twilio (optional, two-way texting)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Email filing (python -m app.cli emailin). Forward or BCC IMAP_USER with the matter number in brackets, e.g. [M-1002]
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
# AI features (Agent H). Precedence at call time: OPENROUTER_API_KEY, then ANTHROPIC_API_KEY. The owner must also turn
# AI on under Settings. Spend is estimated from token counts and capped per UTC day.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
AI_DAILY_CAP_CENTS=300
# LLM_ENABLED=false turns every model call off with no API call. LLM_DAILY_CAP caps model calls per UTC day (0 = none).
LLM_ENABLED=true
LLM_DAILY_CAP=0
# Consult booking page (Calendly or similar). Shown on the intake thank-you page and as {{ booking_url }} in sequences.
BOOKING_URL=

# Install key (self-hosted installs register a free key from coil.legal at first run). Hosted/dev: set to 1.
COIL_SKIP_INSTALL_KEY=
COIL_KEY_VERIFY_URL=https://lawfirmautomate.com/api/coil-verify-key
