{
  "manifest_version": 3,
  "name": "Coil Timer",
  "version": "1.0.0",
  "description": "Search matters, run a timer and log time to Coil from any tab.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coil Timer"
  }
}
